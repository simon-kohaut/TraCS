{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "tracs_gen (local)",
            "type": "debugpy",
            "request": "launch",
            "module": "tracs.cli",
            "args": [
                "scenarios/1_halt.txt",
                "--backend", "local",
                "--coder-model", "google/gemma-4-31B-it",
                "--judge-model", "google/gemma-4-31B-it",
                "--max-iterations", "3"
            ],
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": false
        }
    ]
}
