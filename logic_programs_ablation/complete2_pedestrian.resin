distance(vehicle) <- source("/star_map/distance/vehicle", Density).
distance(motorcyclist) <- source("/star_map/distance/motorcyclist", Density).
distance(bus) <- source("/star_map/distance/bus", Density).
distance(bus_lane) <- source("/star_map/distance/bus_lane", Density).
distance(bike_lane) <- source("/star_map/distance/bike_lane", Density).
distance(crossing) <- source("/star_map/distance/crossing", Density).
over(drivable_area) <- source("/star_map/over/drivable_area", Probability).
over(bike_lane) <- source("/star_map/over/bike_lane", Probability).
over(bus_lane) <- source("/star_map/over/bus_lane", Probability).
over(intersection) <- source("/star_map/over/intersection", Probability).
speed <- source("/sensors/speed", Number).
acceleration <- source("/sensors/acceleration", Number).
yaw_rate <- source("/sensors/yaw_rate", Number).
approaches(vehicle) <- source("/star_map/approaches/vehicle", Probability).

# Pedestrian expectations: low speed, prefers sidewalks and crossings, can be anywhere
pedestrian_implausible_speed if is_pedestrian and speed > 5.
pedestrian_jaywalk if is_pedestrian and over(drivable_area) and distance(crossing) > 5.
pedestrian_ok if not is_pedestrian.
pedestrian_ok if not pedestrian_implausible_speed and not pedestrian_jaywalk.

landscape if pedestrian_ok.

landscape -> target("/landscape").
