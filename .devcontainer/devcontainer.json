// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "TraCS",
	"image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

	"features": {
		"ghcr.io/devcontainers/features/python:1": {
			"version": "3.13",
			"installTools": false
		}
	},

	"containerEnv": {
		"CLINGO_LIBRARY_PATH": "/usr/lib/aarch64-linux-gnu"
	},

	"runArgs": [
		"--add-host=host.docker.internal:host-gateway",  // Needed for accessing self-hosted LLM servers
        "--device", "nvidia.com/gpu=5",
		"--shm-size", "200G",
		"--memory=600g",
		"--memory-swap=600g",
		"--cpus=200"
	],

	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-toolsai.jupyter",
				"charliermarsh.ruff",
				"tamasfe.even-better-toml",
				"Anthropic.claude-code"
			]
		}
	},

	"mounts": [
        // "source=/home/ml-fdivo/repos/TraCS/data,target=/workspaces/data,type=bind,consistency=cached"
    ],

	"postCreateCommand": "bash .devcontainer/postCreate.sh",
	"remoteUser": "root"
}
